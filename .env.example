# Bu dosyayı .env olarak kopyala ve doldur. .env repoya girmez.

# Veritabanı (docker-compose.yml ile uyumlu)
DATABASE_URL=postgresql+psycopg://flyhire:flyhire@localhost:5433/flyhire

# Veri klasörü (connectome dosyaları, karar yüzeyi önbelleği)
DATA_DIR=data

# LLM: "<sağlayıcı>/<model>" biçiminde, Instructor from_provider ile çözülür.
# Örnekler: anthropic/claude-sonnet-5-5, openai/gpt-..., together/<kurum>/<model>, ollama/llama3.1
# Together için araç çağrısını (function calling) destekleyen bir model seçin.
LLM_MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=

# Embedding modeli (çok dilli)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Gmail API OAuth dosyaları (repo dışında tut)
GMAIL_CREDENTIALS_PATH=private/gmail_credentials.json
GMAIL_TOKEN_PATH=private/gmail_token.json
